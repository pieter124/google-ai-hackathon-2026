# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Two ways to authenticate ALL THREE Google calls (Gemini, Speech-to-Text,
# Text-to-Speech) — pick one:
#
# OPTION A — GEMINI_API_KEY (simplest): a plain API key. Set it below and
# you're done — no gcloud, no GCP project needed. Uncomment and fill in:
# GEMINI_API_KEY=YOUR_API_KEY
#   - If this key came from Google AI Studio (https://aistudio.google.com/apikey),
#     it's usually scoped to the Generative Language API only — Gemini calls
#     will work, but Speech-to-Text/Text-to-Speech will 500 with an ADC error
#     until you either enable those two APIs for this key in Google Cloud
#     Console too, or fall back to Option B just for those two routes.
#   - If this key came from Google Cloud Console instead, scope it to all
#     three (Generative Language, Cloud Speech-to-Text, Cloud Text-to-Speech)
#     and it covers every call with zero gcloud setup.
#
# OPTION B — Application Default Credentials (ADC): leave GEMINI_API_KEY
# unset and instead fill in GCP_PROJECT_ID below, then run (one-time,
# installs/updates gcloud if needed):
#   bash <(curl -sSL https://storage.googleapis.com/cloud-samples-data/adc/setup_adc.sh)
# If calls come back with a quota/billing-project error, also run:
#   gcloud auth application-default set-quota-project YOUR_PROJECT_ID

# Your GCP project (must have the Vertex AI API and Cloud Speech-to-Text API
# enabled). Required for Option B; not needed under Option A.
GCP_PROJECT_ID=YOUR_PROJECT_ID

# Vertex AI region for Gemini calls (Option B only).
GCP_LOCATION=europe-west1

# Gemini model for reasoning calls (interview turns, checkpoints, scorecard).
GEMINI_MODEL=gemini-3.6-flash

# Local port for the server (serves both the frontend and the /api/* proxy).
PORT=8000
