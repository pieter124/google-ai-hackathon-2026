# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Gemini itself supports two auth modes; Speech-to-Text and Text-to-Speech
# do NOT — confirmed against the live APIs, they reject API keys outright
# ("API keys are not supported by this API") and always need a real OAuth2
# principal. So:
#
# - GEMINI_API_KEY (optional, simplest for Gemini only): a plain API key.
#   Set it below and Gemini calls need no gcloud/GCP project at all.
#   Uncomment and fill in:
#   GEMINI_API_KEY=YOUR_API_KEY
#
# - ADC (required for voice — Speech-to-Text fallback + Text-to-Speech
#   output — regardless of whether GEMINI_API_KEY is set): fill in
#   GCP_PROJECT_ID below, then run (one-time, installs/updates gcloud if
#   needed):
#   bash <(curl -sSL https://storage.googleapis.com/cloud-samples-data/adc/setup_adc.sh)
# If calls come back with a quota/billing-project error, also run:
#   gcloud auth application-default set-quota-project YOUR_PROJECT_ID
#
# In short: leaving GEMINI_API_KEY unset and just doing ADC covers
# everything in one step. Setting GEMINI_API_KEY only shortcuts the Gemini
# reasoning calls — you still need ADC below for the app to be able to speak
# or transcribe.

# Your GCP project (must have the Vertex AI API, Cloud Speech-to-Text API,
# and Cloud Text-to-Speech API enabled). Required for ADC.
GCP_PROJECT_ID=YOUR_PROJECT_ID

# Vertex AI region for Gemini calls when using ADC (i.e. GEMINI_API_KEY unset).
GCP_LOCATION=europe-west1

# Gemini model for reasoning calls (interview turns, checkpoints, scorecard).
GEMINI_MODEL=gemini-3.6-flash

# Local port for the server (serves both the frontend and the /api/* proxy).
PORT=8000
